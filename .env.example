# Server port (the Vite dev server proxies /api and /socket.io here)
PORT=3001
# Socket.IO rate-limit client IPs: comma-separated trusted proxy IPs/CIDRs (IPv4 or IPv6).
# Default: trust none; direct connections always use the socket peer address.
# Only listed peers may supply X-Forwarded-For; chains are walked right-to-left to the first untrusted hop.
# For a local reverse proxy only: TRUST_PROXY=127.0.0.1,::1
# Render/Fly: set verified ingress proxy IPs/CIDRs for your deployment (docs/DEPLOYMENT.md).
# Boolean true and hop counts are rejected. Unset/empty/false trusts none.
TRUST_PROXY=
# Camera source mode (default when unset: auto).
#   auto       real Caltrans imagery where verified (LIVE HLS > SNAPSHOT > labelled SIMULATED), health-checked politely
#   live       like auto, but only cameras with a verified live HLS stream show real imagery (others SIMULATED)
#   snapshot   stills only (HLS never probed)
#   simulation fully offline: every feed is the labelled procedural simulation, zero external requests
# Real camera trouble never stops a match: cameras degrade to SIMULATED automatically.
CAMERA_MODE=auto
# Optional camera tunables (defaults shown): per-camera re-check cadence, request timeout, max parallel probes,
# suggested client snapshot refresh.
# CAMERA_CHECK_INTERVAL_MS=300000
# CAMERA_TIMEOUT_MS=8000
# CAMERA_CONCURRENCY=3
# CAMERA_REFRESH_MS=60000
# TEST ONLY: send every probe to this origin instead of Caltrans (e.g. http://10.255.255.1 to simulate an outage)
# CAMERA_PROBE_ORIGIN=
# Comma-separated allowed origins for Socket.IO CORS when the client is hosted elsewhere (default: reflect origin)
# CORS_ORIGIN=https://example.com
# Client dev server only: where to proxy the API (default 3001)
# API_PORT=3001
