# Server port (the Vite dev server proxies /api and /socket.io here)
PORT=3001
# Camera source mode: auto | live | snapshot | simulation
# (wave 1 implements only `simulation`; other values fall back to it with a log line)
CAMERA_MODE=simulation
# Comma-separated allowed origins for Socket.IO CORS when the client is hosted elsewhere (default: reflect origin)
# CORS_ORIGIN=https://example.com
# Client dev server only: where to proxy the API (default 3001)
# API_PORT=3001
